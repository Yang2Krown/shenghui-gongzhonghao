# 后端环境变量示例文件
# 复制此文件为 .env 并填入实际值

# 项目配置
PROJECT_NAME=AI公众号内容运营平台
DEBUG=true

# 安全配置
SECRET_KEY=your-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=4320
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# 数据库配置（生产 = Postgres + pgvector）
# 本地 dev：连 Docker 里的 pgvector 容器；生产：连服务器上的 pgvector
# 注意：必须用 pgvector 镜像（pgvector/pgvector:pg16 等），普通 postgres 没装 vector 扩展
POSTGRES_SERVER=localhost
POSTGRES_PORT=54328              # 服务器上一般是 5432
POSTGRES_USER=root               # 改成你服务器上的用户
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_content_hub

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
PROGRESS_STORE_REDIS_ENABLED=true
PROGRESS_STORE_TTL_SECONDS=3600
PROGRESS_STORE_REDIS_PREFIX=progress

# Celery配置
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ====== LLM 配置 ======
# DeepSeek (Phase 2 默认: 信息类型 + 要素提取)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Anthropic Claude (Phase 3 默认: Agent A/B 选题挖掘)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_API_BASE=https://api.anthropic.com

# AIGoCode Claude (Claude Opus 4.8，标题生成专用)
AIGOCODE_API_KEY=your-aigocode-api-key
AIGOCODE_API_BASE=https://api.aigocode.com

# OpenAI / 通义千问 (备用)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
TONGYI_API_KEY=
TONGYI_API_BASE=https://dashscope.aliyuncs.com/api/v1

# ====== Embedding 配置 ======
# 默认阿里云百炼 text-embedding-v3，OpenAI-compatible
EMBEDDING_PROVIDER=dashscope
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=your-dashscope-api-key
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# ====== TopHub 榜眼数据 API ======
# 接入 36kr / 虎嗅 / 知乎 / 微信公众号 / 量子位 等热榜
TOPHUB_API_KEY=your-tophub-key
TOPHUB_API_BASE=https://api.tophubdata.com

# ====== 小红书关键词素材库 ======
# 默认关闭；服务器配置 Token/Cookie 并完成 3 关键词灰度后再开启。
XHS_COLLECTION_ENABLED=false
# 本地 Agent 上线后必须保持 false，防止服务器 CLI/TikHub 自动搜索。
XHS_SERVER_COLLECTION_ENABLED=false
TIKHUB_TOKEN=
TIKHUB_API_BASE=https://api.tikhub.io
TIKHUB_DAILY_LIMIT=100
TIKHUB_UNIT_PRICE_CNY=0
XHS_CLI_BIN=xhs
# Cookie 只放私密文件，严禁写入本文件、数据库和日志。
XHS_CLI_COOKIE_FILE=/app/secrets/xhs/cookies.json
XHS_CLI_VERSION=0.6.4

# ====== 大佳啦公众号历史/当天发文 API ======
#
# 固定公众号博主源：日常 post_condition，手动补库 post_history
DAJIALA_API_KEY=
DAJIALA_VERIFYCODE=

# ====== 默认 provider ======
LLM_PROVIDER=deepseek            # deepseek / anthropic / aigocode
DEFAULT_AI_MODEL=deepseek-chat
DEFAULT_AI_PROVIDER=deepseek

# CORS配置
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=20971520
ARTICLE_REVIEW_MAX_FILE_SIZE=20971520
ARTICLE_REVIEW_MAX_FILES_SIZE=41943040
ARTICLE_REVIEW_MAX_REQUEST_SIZE=47185920

# ====== Pixus AI 图像生成（公众号封面等）======
PIXUS_API_KEY=your-pixus-api-key
PIXUS_API_BASE=https://pixus.dev
