# ============================================================
# 生产环境 .env 模板
# 复制为 .env.production 后填入真实值，然后：
#   docker compose -f docker-compose.prod.yml --env-file backend/.env.production up -d
# ============================================================

# 项目配置
PROJECT_NAME=AI公众号选题平台
DEBUG=false

# 安全配置（生产必须改）
SECRET_KEY=请用 python -c "import secrets; print(secrets.token_urlsafe(48))" 生成新值
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080
SUPER_ADMIN_PHONE=18021751281

# 数据库（docker-compose 里的 service 名当 host）
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=换成强密码
POSTGRES_DB=ai_content_hub

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ====== LLM ======
DEEPSEEK_API_KEY=你的 DeepSeek key
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE=https://api.anthropic.com
AIGOCODE_API_KEY=
AIGOCODE_API_BASE=https://api.aigocode.com

# ====== Embedding ======
EMBEDDING_PROVIDER=dashscope
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=你的 DashScope key
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# ====== 默认 provider ======
LLM_PROVIDER=deepseek

# ====== TopHub ======
TOPHUB_API_KEY=你的 TopHub key
TOPHUB_API_BASE=https://api.tophubdata.com

# ====== X (Twitter) cookie ——可选 ======
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# ====== Exa API（微信公众号搜索）======
EXA_API_KEY=你的Exa API Key（https://exa.ai 注册获取）

# ====== 博查 Bocha（实操类爆文搜索，国内可充值）======
# 去 open.bochaai.com 充值拿 key
BOCHA_API_KEY=你的博查 API Key

# ====== HTTP 代理（访问境外网站：HN/Reddit/V2EX/GitHub）======
# 如果服务器在国内无法访问境外网站，配置代理地址，例如：
# HTTP_PROXY=http://127.0.0.1:7890
HTTP_PROXY=

# ====== 阿里云短信 ======
ALIYUN_SMS_ACCESS_KEY_ID=你的阿里云AccessKeyId
ALIYUN_SMS_ACCESS_KEY_SECRET=你的阿里云AccessKeySecret
ALIYUN_SMS_SIGN_NAME=你的短信签名
ALIYUN_SMS_TEMPLATE_CODE=你的短信模板编号

# ====== 前端 / nginx ======
# 服务器上跑在 80 端口（如果 80 被宝塔占了，改成 8080）
WEB_HTTP_PORT=80

# CORS（前端域名）
BACKEND_CORS_ORIGINS=["https://your-domain.com","http://your-server-ip"]
ALLOWED_HOSTS=["your-domain.com","your-server-ip","localhost"]

# 上传
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=10485760

# 阿里云 OSS（公众号图片上传）
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET_NAME=your-bucket-name
OSS_DIR=gzh-images

# 飞书商单 brief 接入（开放平台自建应用，凭证与基础信息页获取）
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=your-feishu-app-secret

# Pixus AI 图像生成（封面图）
PIXUS_API_KEY=你的 Pixus API Key
PIXUS_API_BASE=https://pixus.dev

# ====== 微信支付 v3 Native 扫码支付 ======
# WXPAY_TEST_MODE=true 表示真实调微信支付，但金额强制 1 分钱；链路确认后改 false。
WXPAY_TEST_MODE=true
WXPAY_MCH_ID=your-wechat-pay-merchant-id
WXPAY_APP_ID=your-wechat-app-id
WXPAY_API_V3_KEY=your-32-char-api-v3-key
WXPAY_PRIVATE_KEY_PATH=/app/secrets/wxpay/apiclient_key.pem
WXPAY_MCH_SERIAL_NO=your-merchant-certificate-serial-no
WXPAY_PUBLIC_KEY_PATH=/app/secrets/wxpay/pub_key.pem
WXPAY_PUBLIC_KEY_ID=your-wechat-pay-public-key-id
WXPAY_NOTIFY_URL=https://your-domain.example.com/api/v1/credits/pay/notify
